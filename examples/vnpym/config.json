{
    "lab_path": "lab/vnpym",
    "symbols": [
        "BTCUSDT.BINANCE",
        "ETHUSDT.BINANCE",
        "BNBUSDT.BINANCE",
        "SOLUSDT.BINANCE"
    ],
    "interval": "1h",
    "start": "2024-01-01",
    "end": "2024-12-31",
    "datafeed": {
        "source": "crypto_gateway",
        "name": "",
        "username": "",
        "password": "",
        "save_to_database": true
    },
    "crypto_gateway": {
        "name": "binance_spot",
        "server": "REAL",
        "usdt_base": true,
        "rest_host": "https://www.binance.com",
        "proxy_host": "127.0.0.1",
        "proxy_port": 7897,
        "use_env_proxy": false,
        "request_retries": 3,
        "retry_delay": 1.0
    },
    "training": {
        "model_name": "vnpym_model",
        "signal_name": "vnpym_signal",
        "feature_window": 20,
        "label_horizon": 5,
        "valid_ratio": 0.2,
        "ridge_alpha": 1.0
    },
    "execution": {
        "mode": "paper",
        "capital": 1000000,
        "cash_ratio": 0.95,
        "top_k": 3,
        "long_only": true,
        "min_volume": 100,
        "price_add": 0,
        "output_path": "lab/vnpym/execution",
        "allow_live_trading": false,
        "gateway_module": "",
        "gateway_class": "",
        "gateway_name": "",
        "gateway_setting": {}
    }
}
